# Copier en .env.local — JAMAIS commiter .env.local (le dépôt est public).

# Mode simulé : tout le parcours tourne sans réseau ni clé
USE_MOCKS=true

# Supabase — Postgres + pgvector + stockage audio
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # secret serveur, jamais côté client
SUPABASE_AUDIO_BUCKET=audio

# ASR
GROQ_API_KEY=                       # français / anglais
ASR_REMOTE_URL=                     # service dioula/baoulé (services/asr-remote), Linux uniquement

# Structuration et embeddings
GEMINI_API_KEY=

# WhatsApp Cloud API (numéro de test en développement)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Banc d'essai (facultatif)
HF_TOKEN=                           # corpus et modèles à accès restreint
ANTHROPIC_API_KEY=
